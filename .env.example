# Copy this file to .env and put the scoring-model key below.
# Official OpenAI-compatible providers are supported. Ark/Doubao is recommended
# for the screenshot judge when the deployed endpoint supports image_url input
# and response_format={"type":"json_object"}.
MOMOZI_JUDGE_API_KEY=
MOMOZI_JUDGE_PROVIDER=ark
MOMOZI_JUDGE_MODEL=
MOMOZI_JUDGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MOMOZI_VLM_API_KEY=
MOMOZI_VLM_PROVIDER=ark
MOMOZI_VLM_MODEL=
MOMOZI_VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional aliases for teams that name Ark credentials after the Doubao product.
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=

# Legacy DeepSeek names remain accepted for compatibility.
DEEPSEEK_API_KEY=
DEEPSEEK_JUDGE_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VLM_MODEL=deepseek-v4-flash
DEEPSEEK_VLM_BASE_URL=https://api.deepseek.com
